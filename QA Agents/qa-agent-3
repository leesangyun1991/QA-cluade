## APP (Appium) 코드 패턴

### conftest.py - APP 세팅
```python
import pytest
from appium import webdriver
from appium.options import XCUITestOptions, UiAutomator2Options

@pytest.fixture(scope="function")
def driver(request):
    platform = request.config.getoption("--platform", default="ios")

    if platform.lower() == "ios":
        options = XCUITestOptions()
        options.bundle_id = "com.yourapp.bundle"      # TODO: 실제 번들 ID로 교체
        options.device_name = "iPhone 15"
        options.platform_version = "17.0"
    else:
        options = UiAutomator2Options()
        options.app_package = "com.yourapp"            # TODO: 실제 패키지명으로 교체
        options.app_activity = ".MainActivity"

    driver = webdriver.Remote("http://localhost:4723", options=options)
    yield driver
    driver.quit()
```

### Page Object - APP
```python
# pages/app/[feature]_page.py
import os
from appium.webdriver.common.appiumby import AppiumBy
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

class [Feature]AppPage:
    # Locators (우선순위: accessibility_id > id > xpath)
    ELEMENT = (AppiumBy.ACCESSIBILITY_ID, "element_label")  # TODO: 실제 locator로 교체

    def __init__(self, driver):
        self.driver = driver
        self.wait = WebDriverWait(driver, 10)

    def take_screenshot(self, name: str):
        os.makedirs("screenshots", exist_ok=True)
        self.driver.save_screenshot(f"screenshots/{name}.png")
```

